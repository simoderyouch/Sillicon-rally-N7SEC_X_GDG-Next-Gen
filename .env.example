POSTGRES_DB=sillicon_rally
POSTGRES_USER=sillicon
POSTGRES_PASSWORD=change-me
ADMIN_EMAIL=admin@sillicon-rally.local
ADMIN_PASSWORD=change-me-before-an-event
FRONTEND_PORT=5173
FRONTEND_BIND_ADDRESS=127.0.0.1

# Leave these blank for the Docker frontend. Nginx proxies API and WebSocket
# requests through the same browser origin.
VITE_API_BASE_URL=
VITE_LEADERBOARD_WS_URL=
# Comma-separated exact origins. Do not use a wildcard. For production, set
# this to https://silicon-rally.edder.studio only.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://silicon-rally.edder.studio
OPEN_TEAM_REGISTRATION=true

